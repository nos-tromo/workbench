# workbench — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)

# =============================================================================
# Auth & identity
# =============================================================================

# The bearer key docint presents on every call: docint holds the same value
# as WORKBENCH_API_KEY, and deploy's `make env` fills it. At least 32
# characters when set; generate it with `openssl rand -hex 32`. Unset,
# docint's door is off. The api needs one of the two keys.
# [secret] [shared: docint WORKBENCH_API_KEY]
# DOCINT_WORKBENCH_KEY=

# The bearer key Ghostwriter presents on every call: Ghostwriter holds the
# same value as WORKBENCH_API_KEY, and deploy's `make env` fills it. At least
# 32 characters when set; generate it with `openssl rand -hex 32`. Unset,
# Ghostwriter's door is off. The api needs one of the two keys.
# [secret] [shared: ghostwriter WORKBENCH_API_KEY]
# GHOSTWRITER_WORKBENCH_KEY=

# =============================================================================
# Network & proxy
# =============================================================================

# Name of the external network between the api and its callers. Created via
# `make network`. Override only if you renamed it.
# WORKBENCH_NET=workbench-net

# =============================================================================
# workbench
# =============================================================================

# --- Jobs ---

# Jobs the executor runs at once, one slot uid each; at most 16.
# WORKBENCH_EXECUTOR_SLOTS=4

# Jobs that may wait for a free slot; past it a call answers "busy" at once.
# WORKBENCH_QUEUE_MAX=16

# Jobs one user may have running at once; their further calls wait, at most
# WORKBENCH_QUEUE_MAX / WORKBENCH_EXECUTOR_SLOTS of them (at least one).
# WORKBENCH_JOBS_PER_USER=1

# Wall-clock seconds a job may run.
# WORKBENCH_JOB_WALL_S=120

# Memory one job may use, in MB. WORKBENCH_EXECUTOR_MEM_LIMIT must hold the
# slots times this.
# WORKBENCH_JOB_MEMORY_MB=1536

# Largest text a tool returns to the model, in KB; at most 256.
# WORKBENCH_RESULT_MAX_KB=16

# --- docint ---

# Tools docint may call, comma-separated; each needs an inline form.
# DOCINT_WORKBENCH_TOOLS=run_python

# Wall-clock seconds one docint job may run: from 5 to WORKBENCH_JOB_WALL_S.
# DOCINT_WORKBENCH_WALL_S=60

# Jobs docint may have running at once; fewer than WORKBENCH_EXECUTOR_SLOTS.
# DOCINT_WORKBENCH_SLOTS=2

# --- ghostwriter ---

# Tools Ghostwriter may call, comma-separated; each a workspace tool.
# GHOSTWRITER_WORKBENCH_TOOLS=list_files,read_document,search_files,run_python,inspect_template,fill_template,write_table,write_document,write_presentation

# Wall-clock seconds one Ghostwriter job may run: from 10 to
# WORKBENCH_JOB_WALL_S.
# GHOSTWRITER_WORKBENCH_WALL_S=120

# Jobs Ghostwriter may have running at once; fewer than
# WORKBENCH_EXECUTOR_SLOTS.
# GHOSTWRITER_WORKBENCH_SLOTS=2

# --- Files ---

# Largest upload, per file, in MB.
# WORKBENCH_UPLOAD_MAX_MB=50

# Largest workspace per user, all chats, uploads and tool outputs together,
# in MB. An upload past it answers 507; a tool's file past it is not kept.
# It also bounds what a running job may write.
# WORKBENCH_WORKSPACE_MAX_MB=500

# --- Api container ---

# Memory of the api container, swap included: its upload spool on /tmp
# (512 MiB) and the process. A request body past 2 MiB, or an upload past its
# limit, is refused as it arrives.
# WORKBENCH_API_MEM_LIMIT=2g

# Processes and threads of the api container; it runs one process with up to
# about 80 threads.
# WORKBENCH_API_PIDS_LIMIT=128

# --- Executor container ---

# Memory of the executor container, swap included: slots x job memory +
# 512 MiB for the supervisor (4 x 1536 + 512). The executor refuses to
# start below slots x job memory.
# WORKBENCH_EXECUTOR_MEM_LIMIT=6656m

# Processes of the executor container: 64 per slot plus 64 for the
# supervisor and its cleanup helpers (4 x 64 + 64).
# WORKBENCH_EXECUTOR_PIDS_LIMIT=320

# CPUs the executor container may use, all its jobs together. Docker
# refuses to start it on a host with fewer CPUs: set it to the host's
# number of CPUs or less.
# WORKBENCH_EXECUTOR_CPUS=4

# =============================================================================
# Audit & retention
# =============================================================================

# Days a workspace file or job record is kept after it was created.
# Ghostwriter's previews follow this period, and deploy's `make env` copies
# it there. Set it here, in workbench's .env, which deletes by it: a value
# set only in Ghostwriter's would be copied here.
# [shared: ghostwriter]
# WORKBENCH_RETENTION_DAYS=7

# Seconds between retention sweeps.
# WORKBENCH_RETENTION_INTERVAL_S=300

# Actions a call must state a purpose for, on the MCP door and Ghostwriter's
# file routes. Set it empty, uncommented, to require none. An unknown action
# stops the start.
# AUDIT_REQUIRE_PURPOSE=query,disclose,combine,modify,collect

# =============================================================================
# Development only
# =============================================================================

# Host port of the api in the dev overlay (make up-dev), on 127.0.0.1.
# [dev]
# WORKBENCH_HOST_PORT=8100
