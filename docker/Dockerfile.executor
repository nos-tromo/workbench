FROM ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 AS uv

# ---- Builder: assemble the venv with the executor's libraries ----
FROM docker.io/library/python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS builder
COPY --from=uv /uv /bin/uv

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_DOWNLOADS=0 \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Install dependencies
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --extra executor --no-install-project

# Copy the project into the image
COPY . /app

# Sync the project. Root keeps everything; jobs run as the slot uids and must
# read and run the venv and the package, never change them.
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    uv sync --locked --no-dev --extra executor \
    && chmod -R a+rX,go-w /app

# ---- Test builder: the same venv plus the dev group (make test-executor-root) ----
FROM builder AS test-builder
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    uv sync --locked --extra executor \
    && chmod -R a+rX,go-w /app/.venv

# ---- Runtime: the supervisor, as root, and the slot users its jobs run as ----
FROM docker.io/library/python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

# One user and group per slot, uid = gid = 20001..20016 (WORKBENCH_SLOT_UID_BASE
# and the pool of 16); none can log in or owns a home. The supervisor refuses to
# start unless every slot uid is listed here.
RUN set -eu; \
    for n in $(seq 1 16); do \
        id=$((20000 + n)); \
        groupadd --gid "$id" "slot$n"; \
        useradd --uid "$id" --gid "$id" --no-log-init --no-create-home --home-dir /nonexistent \
            --shell /usr/sbin/nologin "slot$n"; \
    done

# A job's working folder is <job>/workspace/<chat-id>/, so /workspace/<chat-id>/x
# is the job's own copy of x, whichever job asks.
RUN ln -s /proc/self/cwd/.. /workspace

# No setuid or setgid program: no-new-privileges, which the supervisor requires,
# already keeps them inert for a job; the image carries none at all.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +

WORKDIR /app

COPY --from=builder /app /app

# The image's interpreter ships without bytecode and the root is read-only at
# run time, so compile the standard library and the venv once here: each job
# and each cleanup helper is a fresh interpreter, and starts in milliseconds.
RUN python -m compileall -q -j 0 /usr/local/lib/python3.12 /app

# matplotlib's font cache, scanned once here, in this stage, so the font paths
# it records are the image's own. Root's and read-only like the rest: each job
# copies it into a config folder in its private tmp
# (workbench/executor/runners/python.py), since matplotlib scans the fonts
# again whenever its config folder is not writable.
RUN MPLCONFIGDIR=/opt/mpl-cache python -c "import matplotlib.font_manager" \
    && chmod -R a+rX,go-w /opt/mpl-cache

# The supervisor is root with six capabilities (docs/sandbox.md); every job
# drops to its slot's uid before it runs.
USER 0:0

CMD ["python", "-m", "workbench.executor.supervisor"]

# ---- Test: the runtime with pytest (make test-executor-root; never shipped) ----
FROM runtime AS test
COPY --from=test-builder /app/.venv /app/.venv

# ---- The production image ----
FROM runtime
