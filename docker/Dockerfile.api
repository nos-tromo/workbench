FROM ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 AS uv

# ---- Builder: assemble the venv; the api needs no executor extra ----
FROM docker.io/library/python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS builder
COPY --from=uv /uv /bin/uv

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_DOWNLOADS=0 \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Install dependencies
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

# Copy the project into the image
COPY . /app

# Sync the project; everything stays root's and read-only to the app user
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    uv sync --locked --no-dev \
    && chmod -R a+rX,go-w /app

# ---- Runtime: only the prebuilt venv and the package ----
FROM docker.io/library/python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

# Non-root runtime user (deploy ADR 0001). Its uid and gid are the api's in the
# data volume's layout (workbench/executor/prepare_volume.py) and the group of
# the executor's socket. The root is read-only, so HOME is the /tmp tmpfs.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-log-init --no-create-home --home-dir /nonexistent \
       --shell /usr/sbin/nologin app

ENV HOME=/tmp

WORKDIR /app

COPY --from=builder /app /app

USER 10001:10001

EXPOSE 8000

# One process: the store and the audit chain assume a single writer. No access
# log: it would print file names from query strings.
CMD ["uvicorn", "--factory", "workbench.api.main:app_factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
